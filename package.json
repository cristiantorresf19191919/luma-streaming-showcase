{
  "name": "luma",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" playwright.config.ts",
    "prestart": "node scripts/configure-env.mjs",
    "prebuild": "node scripts/configure-env.mjs",
    "pretest": "node scripts/configure-env.mjs",
    "pretest:ui": "node scripts/configure-env.mjs",
    "prewatch": "node scripts/configure-env.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "vite": "^8.3.5"
  }
}
