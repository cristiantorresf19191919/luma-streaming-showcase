{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "app", "installMode": "prefetch", "resources": { "files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/**", "/fonts/**"] } },
    { "name": "posters", "installMode": "lazy", "updateMode": "lazy", "resources": { "files": ["/images/**"] } }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/__forms.html"]
}
