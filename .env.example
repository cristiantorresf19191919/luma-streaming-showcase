# Public Firebase web-app configuration. Never add service-account credentials here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional public GA4 measurement ID (build-time). Analytics is off until opt-in.
GA_MEASUREMENT_ID=

# SERVER ONLY: configure these in Netlify environment variables, Functions scope.
# Never prefix these with FIREBASE_ client config names or put them in frontend code.
# Keep COMMERCE_ENABLED false until sandbox checkout + licensed video pass acceptance.
COMMERCE_ENABLED=false
SITE_URL=https://moviesdiamond.netlify.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
MUX_PLAYBACK_ID=
MUX_SIGNING_KEY_ID=
# Base64 PEM signing key returned by Mux
MUX_SIGNING_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NETLIFY_FORMS_TOKEN=
